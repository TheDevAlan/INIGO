{
  "name": "INIGO",
  "version": "1.0.2",
  "description": "Personal productivity timer and daily wellbeing tracker",
  "author": "Alan Gawlik",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable",
    "build:appx": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win appx"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.inigo.app",
    "productName": "INI:GO",
    "win": {
      "signAndEditExecutable": false,
      "target": ["portable", "appx"],
      "icon": "assets/INIGO-logo-mark.png"
    },
    "appx": {
      "identityName": "TheDevAlan.INIGO",
      "publisher": "CN=09E66166-9C46-4193-97A0-0663E0CB7FEB",
      "publisherDisplayName": "TheDevAlan",
      "applicationId": "INIGO",
      "displayName": "INI:GO",
      "backgroundColor": "#0e0c0a",
      "languages": ["en-US", "de-DE"],
      "showNameOnTiles": true
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "assets/**/*"
    ],
    "extraResources": []
  }
}
