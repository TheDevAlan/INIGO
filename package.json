{
  "name": "daily-flow",
  "version": "0.1.0",
  "description": "Personal daily tracker with Flowtime timer and mood heatmap",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.dailyflow.app",
    "productName": "ZENITH Work & Wellbeing",
    "win": {
      "signAndEditExecutable": false,
      "target": "portable",
      "icon": "assets/zenith-logo-mark.png"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "assets/**/*"
    ],
    "extraResources": []
  }
}
