{
  "name": "daily-flow",
  "version": "1.0.0",
  "description": "Personal productivity timer and daily wellbeing tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.dailyflow.app",
    "productName": "INI:GO",
    "win": {
      "signAndEditExecutable": false,
      "target": "portable",
      "icon": "assets/INIGO-logo-mark.png"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "assets/**/*"
    ],
    "extraResources": []
  }
}
